# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Copy from Render dashboard → Environment Variables → DATABASE_URL
DATABASE_URL=postgresql://...

# ── JWT ──────────────────────────────────────────────────────────────────────
# Copy from Render → JWT_SECRET
JWT_SECRET=your_jwt_secret_here
COOKIE_SECRET=your_cookie_secret_here

# ── Client URL (local dev) ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from Render
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# IMPORTANT: This callback URL must be registered in Google Console!
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Cloudinary (if used for images) ──────────────────────────────────────────
# Copy from Render if these exist
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (if used) ───────────────────────────────────────────────────────────
# Copy from Render if these exist
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
