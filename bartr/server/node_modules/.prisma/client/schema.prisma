// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum SkillStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum NotificationType {
  MATCH
  MESSAGE
  REVIEW
  EXCHANGE
  SYSTEM
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password_hash    String?
  full_name        String
  username         String   @unique
  avatar_url       String?
  university       String?
  department       String?
  year_of_study    Int?
  bio              String?
  reputation_score Float    @default(0)
  is_verified      Boolean  @default(false)
  is_active        Boolean  @default(true)
  google_id        String?  @unique
  onboarding_done  Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Relations
  skills              Skill[]
  offered_exchanges   Exchange[]          @relation("Offerer")
  requested_exchanges Exchange[]          @relation("Requester")
  sent_messages       Message[]
  reviews_given       Review[]            @relation("Reviewer")
  reviews_received    Review[]            @relation("Reviewee")
  portfolios          Portfolio[]
  notifications       Notification[]
  endorsements_given  SkillEndorsement[]  @relation("Endorser")
  email_verifications EmailVerification[]
  password_resets     PasswordReset[]

  @@index([email])
  @@index([username])
  @@index([university])
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  icon        String
  description String?
  skills      Skill[]

  @@index([slug])
}

model Skill {
  id                String           @id @default(cuid())
  user_id           String
  title             String
  description       String
  category_id       String
  proficiency_level ProficiencyLevel
  is_offering       Boolean          @default(true)
  status            SkillStatus      @default(ACTIVE)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  // Relations
  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category            Category           @relation(fields: [category_id], references: [id])
  offered_exchanges   Exchange[]         @relation("OfferedSkill")
  requested_exchanges Exchange[]         @relation("RequestedSkill")
  endorsements        SkillEndorsement[]

  @@index([user_id])
  @@index([category_id])
  @@index([is_offering])
  @@index([status])
}

model Exchange {
  id                  String         @id @default(cuid())
  offerer_id          String
  requester_id        String
  offered_skill_id    String
  requested_skill_id  String
  status              ExchangeStatus @default(PENDING)
  offerer_confirmed   Boolean        @default(false)
  requester_confirmed Boolean        @default(false)
  agreed_at           DateTime?
  completed_at        DateTime?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  // Relations
  offerer         User      @relation("Offerer", fields: [offerer_id], references: [id])
  requester       User      @relation("Requester", fields: [requester_id], references: [id])
  offered_skill   Skill     @relation("OfferedSkill", fields: [offered_skill_id], references: [id])
  requested_skill Skill     @relation("RequestedSkill", fields: [requested_skill_id], references: [id])
  messages        Message[]
  reviews         Review[]

  @@index([offerer_id])
  @@index([requester_id])
  @@index([status])
}

model Message {
  id           String      @id @default(cuid())
  exchange_id  String
  sender_id    String
  content      String
  message_type MessageType @default(TEXT)
  file_url     String?
  read_at      DateTime?
  created_at   DateTime    @default(now())

  // Relations
  exchange Exchange @relation(fields: [exchange_id], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [sender_id], references: [id])

  @@index([exchange_id])
  @@index([sender_id])
}

model Review {
  id          String   @id @default(cuid())
  exchange_id String
  reviewer_id String
  reviewee_id String
  rating      Int
  comment     String?
  created_at  DateTime @default(now())

  // Relations
  exchange Exchange @relation(fields: [exchange_id], references: [id])
  reviewer User     @relation("Reviewer", fields: [reviewer_id], references: [id])
  reviewee User     @relation("Reviewee", fields: [reviewee_id], references: [id])

  @@unique([exchange_id, reviewer_id])
  @@index([reviewee_id])
}

model Portfolio {
  id          String   @id @default(cuid())
  user_id     String
  title       String
  description String?
  file_url    String
  file_type   String
  tags        String[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  type       NotificationType
  title      String
  body       String
  link       String?
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read])
}

model SkillEndorsement {
  id          String   @id @default(cuid())
  skill_id    String
  endorser_id String
  created_at  DateTime @default(now())

  // Relations
  skill    Skill @relation(fields: [skill_id], references: [id], onDelete: Cascade)
  endorser User  @relation("Endorser", fields: [endorser_id], references: [id])

  @@unique([skill_id, endorser_id])
  @@index([skill_id])
}

model EmailVerification {
  id         String    @id @default(cuid())
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
}

model PasswordReset {
  id         String    @id @default(cuid())
  user_id    String
  token      String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
}
